FROM registry.access.redhat.com/ubi9/ubi:latest AS base

ARG TERRAFORM_VERSION=1.15.8
ARG OC_VERSION=4.22
ARG OCI_CLI_VERSION=3.90.1
ARG GIT_REPO_URL=https://github.com/oracle-quickstart/oci-openshift.git
ARG GIT_REPO_BRANCH=main

ENV TF_PLUGIN_CACHE_DIR=/opt/oci-openshift/.terraform-plugin-cache
ENV TF_LOG_PATH=/opt/oci-openshift/terraform-logs/terraform.log

RUN dnf --disableplugin=subscription-manager config-manager --add-repo https://rpm.releases.hashicorp.com/RHEL/hashicorp.repo && \
    dnf --disableplugin=subscription-manager install -y \
           bash \
           bash-completion \
           git \
           gzip \
           jq \
           make \
           openssh-clients \
           python3 \
           python3-pip \
           tar \
           terraform \
           unzip \
           zip && \
    dnf clean all && \
    rm -rf /var/cache/yum /var/cache/dnf && \
    python3 -m pip install --upgrade --no-cache-dir pip && \
    curl -fsSL "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/stable-${OC_VERSION}/openshift-client-linux.tar.gz" \
        -o /tmp/oc.tar.gz \
    && tar -xzf /tmp/oc.tar.gz -C /usr/local/bin/ oc kubectl \
    && chmod +x /usr/local/bin/oc /usr/local/bin/kubectl \
    && rm -f /tmp/oc.tar.gz \
    && groupadd -g 1001 appuser \
    && useradd -u 1001 -g appuser -m -s /bin/bash appuser \
    && mkdir /opt/oci-openshift \
    && chown 1001:1001 /opt/oci-openshift

ENV HOME=/home/appuser

USER 1001

COPY . /opt/oci-openshift

WORKDIR /opt/oci-openshift

RUN pip3 install --user --no-cache-dir oci-cli==${OCI_CLI_VERSION} \
    && bash -c "$(curl -L https://raw.githubusercontent.com/oracle/oci-cli/master/scripts/install/install.sh)" -- --accept-all-defaults \
    && mkdir /opt/oci-openshift/.terraform-plugin-cache /opt/oci-openshift/terraform-logs \
    && git clone --branch "${GIT_REPO_BRANCH}" "${GIT_REPO_URL}" && \
    cd oci-openshift && \
    for stack in terraform-stacks/create-cluster \
                 terraform-stacks/add-nodes \
                 terraform-stacks/create-instance-role-tags \
                 terraform-stacks/create-resource-attribution-tags \
                 terraform-stacks/create-autoscaler-operator; do \
        echo "==> terraform init: ${stack}" \
        && terraform -chdir="${stack}" init -backend=false \
        || exit 1; \
    done

ENTRYPOINT ["/bin/bash"]
